# Set these in your shell. The demo does not automatically load this file.
EMBEDDING_API_KEY=replace-with-your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Chat completion settings. Choose a chat model available at your endpoint.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-your-chat-model
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5
# OPENAI_API_KEY is a fallback for both providers when their own key is unset.
# Local endpoints that do not require authentication may omit the API key.

# FastAPI uses the same providers and index as the CLI.
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=regulatory_documents
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO

# Streamlit frontend: only the API connection is needed; no provider keys.
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=120
